// The three tabs. Each is a column of sections; the window wraps it in a scroll view.
import { Button, LineEdit, ProgressIndicator } from "std-widgets.slint";
import { Theme, Glyphs, Icon } from "theme.slint";
import { ControlKind, DisplayEntry } from "types.slint";
import { App } from "app.slint";
import { SectionHeader, CardFrame, Card, SliderRow, RowDivider, TileButton, InputSelector, Keycap, LabelledSwitch, ExpanderCard, InfoBar, SyncCombo, FocusRing, IconButton, EmptyState, OffsetStepper, SyncSwitch } from "controls.slint";

// VCP codes the pages tell apart: contrast (0x12) and volume (0x62).
global Codes {
    out property <int> contrast: 18;
    out property <int> volume: 98;
}

export component DisplayPage inherits VerticalLayout {
    in property <bool> compact;
    property <bool> custom-open;
    property <bool> has-colour: App.colour-modes.length > 0 || App.custom-colour.length > 0;
    property <bool> has-any: App.inputs.length > 0 || App.main-ranges.length > 0 || root.has-colour;
    // Connected and writable; `disabled-reason` says why not (e.g. a read-only display).
    property <bool> writable: App.connected && App.disabled-reason == "";
    // `main-ranges` is brightness, contrast, then volume, each only when the display has it.
    property <bool> has-picture: App.main-ranges.length > 0 && App.main-ranges[0].code != Codes.volume;
    property <bool> has-volume: App.main-ranges.length > 0 && App.main-ranges[App.main-ranges.length - 1].code == Codes.volume;

    if !root.has-any: EmptyState {
        title: App.empty-title;
        message: App.empty-message;
        busy: App.loading;
    }

    if App.inputs.length > 0: SectionHeader {
        text: @tr("Input");
        hint: App.experimental ? @tr("Names from the monitor's capability report") : "";
        first: true;
    }
    if App.inputs.length > 0: InputSelector {
        inputs: App.inputs;
        active: App.active-input;
        // No second confirm while one is open.
        enabled: root.writable && !App.dialog.visible;
        compact: root.compact;
        select(code) => { App.select-input(code); }
    }
    if App.inputs.length > 0 && App.input-note != "": Text {
        text: App.input-note;
        font-size: 12px;
        color: Theme.error-fg;
        wrap: word-wrap;
    }

    if root.has-picture: SectionHeader {
        text: App.main-ranges.length > 1 && App.main-ranges[1].code == Codes.contrast ? @tr("Brightness and contrast") : App.main-ranges[0].label;
        first: App.inputs.length == 0;
    }
    if root.has-picture: CardFrame {
        VerticalLayout {
            padding-top: 2px;
            padding-bottom: 2px;
            for r[i] in App.main-ranges: VerticalLayout {
                if r.code != Codes.volume && i > 0: RowDivider { }
                // Greyed, still showing the last values, while the display isn't responding.
                if r.code != Codes.volume: SliderRow {
                    glyph: r.glyph;
                    label: r.label;
                    value: r.value;
                    revision: r.revision;
                    maximum: r.maximum;
                    enabled: r.enabled && root.writable;
                    known: r.enabled;
                    changed(v) => { App.range-changed(r.code, v); }
                    released(v) => { App.range-released(r.code, v); }
                }
            }
        }
    }
    if App.range-note != "": Text {
        text: App.range-note;
        font-size: 12px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }

    if root.has-volume: SectionHeader { text: @tr("Sound"); first: App.inputs.length == 0 && !root.has-picture; }
    if root.has-volume: CardFrame {
        VerticalLayout {
            padding-top: 2px;
            padding-bottom: 2px;
            for r in App.main-ranges: VerticalLayout {
                if r.code == Codes.volume: SliderRow {
                    glyph: r.glyph;
                    label: r.label;
                    value: r.value;
                    revision: r.revision;
                    maximum: r.maximum;
                    enabled: r.enabled && root.writable;
                    known: r.enabled;
                    changed(v) => { App.range-changed(r.code, v); }
                    released(v) => { App.range-released(r.code, v); }
                }
            }
        }
    }

    if App.presets.length > 0 && root.has-any: SectionHeader { text: @tr("Presets"); }
    if App.presets.length > 0 && root.has-any: HorizontalLayout {
        spacing: 6px;
        for p[i] in App.presets: TileButton {
            horizontal-stretch: 1;
            glyph: p.glyph;
            label: p.name;
            caption: root.compact ? "" : p.summary;
            enabled: root.writable;
            clicked => { App.apply-preset(i); }
        }
    }
    if App.presets.length > 0 && root.has-any && App.preset-note != "": Text {
        text: App.preset-note;
        font-size: 12px;
        color: Theme.error-fg;
        wrap: word-wrap;
    }
    // Only the built-in panel has no presets: say so instead of showing nothing.
    if App.presets.length == 0 && root.has-any: SectionHeader { text: @tr("Day and Night"); }
    if App.presets.length == 0 && root.has-any: CardFrame {
        HorizontalLayout {
            padding: 12px;
            padding-left: 16px;
            spacing: 12px;
            Icon {
                text: Glyphs.moon;
                font-size: 18px;
                width: 18px;
            }
            Text {
                horizontal-stretch: 1;
                text: @tr("The built-in display has no Day and Night presets. It keeps the brightness you set here.");
                font-size: 12px;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
        }
    }

    if root.has-colour: SectionHeader { text: @tr("Colour"); first: App.inputs.length == 0 && App.main-ranges.length == 0; }
    if root.has-colour: VerticalLayout {
        spacing: 4px;
        Card {
            glyph: Glyphs.colour;
            title: @tr("Colour mode");
            note: App.colour-note;
            reason: App.disabled-reason;
            enabled: root.writable;
            SyncCombo {
                model: App.colour-modes;
                index: App.colour-mode-index;
                revision: App.colour-revision;
                enabled: root.writable;
                selected => { App.colour-mode-selected(self.current-index); }
            }
        }
        ExpanderCard {
            glyph: Glyphs.options;
            title: @tr("Custom colour");
            description: App.connected ? App.custom-colour-hint : App.disabled-reason;
            enabled: App.custom-colour-available && App.connected;
            expanded <=> root.custom-open;
            for r in App.custom-colour: SliderRow {
                glyph: "";
                label: r.label;
                value: r.value;
                revision: r.revision;
                maximum: r.maximum;
                enabled: r.enabled && App.custom-colour-available && root.writable;
                known: r.enabled;
                changed(v) => { App.range-changed(r.code, v); }
                released(v) => { App.range-released(r.code, v); }
            }
        }
    }

    // No verified profile: the report is how the display gets one.
    if App.experimental: SectionHeader { text: @tr("Help support this display"); }
    if App.experimental: Card {
        glyph: Glyphs.copy;
        title: @tr("Capability report");
        description: @tr("What {0} says it can do. Paste it into a new issue.", App.model-name);
        Button {
            text: @tr("Copy capability report");
            clicked => { App.copy-capability-report(); }
        }
    }
}

// One display in Together mode: whether it's included, and its offset from the master sliders.
component IncludedRow inherits VerticalLayout {
    in property <DisplayEntry> entry;
    property <bool> gone: root.entry.state == "disconnected";

    pure function can-do(d: DisplayEntry) -> string {
        if d.state == "disconnected" { return @tr("Disconnected · its offset is kept"); }
        if d.state == "not-responding" { return @tr("Not responding"); }
        if d.kind == "built-in" { return @tr("Brightness only"); }
        d.has-volume ? @tr("Brightness, contrast, volume") : @tr("Brightness, contrast")
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.entry.name;
                font-size: 14px;
                overflow: elide;
                color: root.gone ? Theme.text-secondary : Theme.text;
            }
            Text {
                text: root.can-do(root.entry);
                font-size: 12px;
                overflow: elide;
                color: Theme.text-secondary;
            }
        }
        VerticalLayout {
            alignment: center;
            SyncSwitch {
                on: root.entry.included;
                accessible-label: @tr("Include {0}", root.entry.name);
                toggled => { App.set-included(root.entry.id, self.checked); }
            }
        }
    }
    if root.entry.included: Rectangle {
        background: Theme.card-bg-secondary;
        HorizontalLayout {
            padding-left: Theme.narrow ? 16px : 32px;
            padding-right: 16px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                text: @tr("Offset from the master sliders");
                font-size: 13px;
                color: Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
            OffsetStepper {
                value: root.entry.offset;
                label: @tr("{0} offset", root.entry.name);
                changed(v) => { App.set-offset(root.entry.id, v); }
            }
        }
    }
}

// All together: which displays are included, then one master slider per control (in percent) with the included
// displays that lack it greyed underneath, and the Day and Night presets for all of them.
export component TogetherPage inherits VerticalLayout {
    in property <bool> compact;

    // Why an included display doesn't follow the master slider for `code`; "" when it does.
    pure function missing(d: DisplayEntry, code: int) -> string {
        if d.state == "disconnected" { return @tr("Disconnected · its offset is kept"); }
        if d.state == "not-responding" { return @tr("Not responding"); }
        if (code == Codes.contrast || code == Codes.volume) && d.kind == "built-in" { return @tr("Not controlled over DDC/CI"); }
        if code == Codes.volume && !d.has-volume { return @tr("No volume control reported"); }
        ""
    }

    SectionHeader { text: @tr("Included displays"); first: true; }
    CardFrame {
        VerticalLayout {
            for d[i] in App.displays: VerticalLayout {
                if i > 0: RowDivider { }
                IncludedRow { entry: d; }
            }
        }
    }

    SectionHeader { text: @tr("Move together"); hint: @tr("Offsets keep the gap between displays"); }
    VerticalLayout {
        spacing: 4px;
        for r in App.main-ranges: CardFrame {
            VerticalLayout {
                padding-top: 2px;
                padding-bottom: 2px;
                SliderRow {
                    glyph: r.glyph;
                    label: r.label;
                    value: r.value;
                    revision: r.revision;
                    maximum: r.maximum;
                    enabled: r.enabled;
                    known: r.enabled;
                    changed(v) => { App.range-changed(r.code, v); }
                    released(v) => { App.range-released(r.code, v); }
                }
                for d in App.displays: VerticalLayout {
                    if d.included && root.missing(d, r.code) != "": Rectangle {
                        background: Theme.card-bg-secondary;
                        accessible-role: text;
                        accessible-label: @tr("{0}: {1}", d.name, root.missing(d, r.code));
                        HorizontalLayout {
                            padding-left: Theme.narrow ? 16px : 50px;
                            padding-right: 16px;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: 12px;
                            Text {
                                horizontal-stretch: 1;
                                text: d.name;
                                font-size: 13px;
                                color: Theme.text-disabled;
                                overflow: elide;
                                accessible-role: none;
                            }
                            Text {
                                horizontal-stretch: 2;
                                text: root.missing(d, r.code);
                                font-size: 12px;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                                accessible-role: none;
                            }
                        }
                    }
                }
            }
        }
    }
    // Why a master slider is greyed, or which displays it leaves out.
    if App.range-note != "": Text {
        text: App.range-note;
        font-size: 12px;
        color: Theme.text-secondary;
        wrap: word-wrap;
        accessible-live-region: polite;
    }

    if App.presets.length > 0: SectionHeader { text: @tr("Presets"); hint: @tr("Every included display"); }
    if App.presets.length > 0: HorizontalLayout {
        spacing: 6px;
        for p[i] in App.presets: TileButton {
            horizontal-stretch: 1;
            glyph: p.glyph;
            label: p.name;
            caption: root.compact ? "" : @tr("Brightness and contrast");
            clicked => { App.apply-preset(i); }
        }
    }
    if App.presets.length > 0 && App.preset-note != "": Text {
        text: App.preset-note;
        font-size: 12px;
        color: Theme.error-fg;
        wrap: word-wrap;
    }

    VerticalLayout {
        padding-top: 14px;
        Text {
            text: @tr("Input, colour and the Monitor tab stay per display. Pick a display above to change them.");
            font-size: 12px;
            color: Theme.text-secondary;
            wrap: word-wrap;
        }
    }
}

export component MonitorPage inherits VerticalLayout {
    if App.monitor-groups.length == 0: EmptyState {
        title: App.empty-title;
        message: App.empty-message;
        busy: App.loading;
    }

    for g[gi] in App.monitor-groups: VerticalLayout {
        SectionHeader { text: g.title; first: gi == 0; }
        VerticalLayout {
            spacing: 4px;
            for row in g.rows: Card {
                glyph: row.glyph;
                title: row.label;
                description: row.description;
                note: row.note;
                reason: App.disabled-reason;
                enabled: row.enabled && App.connected;
                if row.kind == ControlKind.choice: SyncCombo {
                    model: row.options;
                    index: row.index;
                    revision: row.revision;
                    enabled: row.enabled && App.connected;
                    selected => { App.control-changed(row.code, self.current-index); }
                }
                if row.kind == ControlKind.toggle: LabelledSwitch {
                    checked: row.index == 1;
                    revision: row.revision;
                    enabled: row.enabled && App.connected;
                    toggled(on) => { App.control-changed(row.code, on ? 1 : 0); }
                }
                if row.kind == ControlKind.action: Button {
                    text: row.button;
                    // No second confirm while one is open.
                    enabled: row.enabled && App.connected && !App.dialog.visible;
                    clicked => { App.control-action(row.code); }
                }
            }
        }
    }

    SectionHeader { text: @tr("Backup"); }
    Card {
        glyph: Glyphs.reset;
        title: @tr("Restore backup");
        description: App.restore-text;
        reason: App.disabled-reason;
        enabled: App.connected;
        Button {
            text: @tr("Restore");
            enabled: App.connected;
            clicked => { App.restore-backup(); }
        }
    }

    SectionHeader { text: @tr("Tools"); }
    Card {
        glyph: Glyphs.search;
        title: @tr("Find hidden settings");
        description: @tr("Look for settings your monitor supports but doesn't list");
        enabled: App.has-controls;
        Button {
            text: @tr("Open");
            enabled: App.has-controls;
            clicked => { App.finder-open = true; App.find-hidden(); }
        }
    }
}

// Shortcut editor: captures key presses (Rust validates them), Esc cancels, Enter saves, Tab moves focus.
export component ShortcutDialog inherits Rectangle {
    background: #00000066;
    TouchArea { }

    // The conflict dialog takes focus; give it back to the capture area when it closes.
    property <bool> blocked: App.dialog.visible;
    changed blocked => { if !root.blocked { capture.focus(); } }

    // Tab and Shift+Tab cycle through the capture area and the enabled buttons, never the page behind.
    function focus-next() {
        if capture.has-focus { reset-button.focus(); }
        else if reset-button.has-focus && App.editor.can-clear { clear-button.focus(); }
        else if (reset-button.has-focus || clear-button.has-focus) && App.editor.can-save { save-button.focus(); }
        else if reset-button.has-focus || clear-button.has-focus || save-button.has-focus { cancel-button.focus(); }
        else { capture.focus(); }
    }
    function focus-previous() {
        if capture.has-focus { cancel-button.focus(); }
        else if cancel-button.has-focus && App.editor.can-save { save-button.focus(); }
        else if (cancel-button.has-focus || save-button.has-focus) && App.editor.can-clear { clear-button.focus(); }
        else if cancel-button.has-focus || save-button.has-focus || clear-button.has-focus { reset-button.focus(); }
        else { capture.focus(); }
    }

    // Esc cancels from anywhere in the dialog, buttons included.
    FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        key-pressed(e) => {
            if e.text == Key.Escape { App.editor-cancel(); return accept; }
            if e.text == Key.Backtab || (e.text == Key.Tab && e.modifiers.shift) { root.focus-previous(); return accept; }
            if e.text == Key.Tab { root.focus-next(); return accept; }
            reject
        }

        CardFrame {
            width: min(parent.width - 32px, 440px);
            height: body.preferred-height;
            background: Theme.layer-bg;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000055;
            accessible-role: groupbox;
            accessible-label: @tr("Edit shortcut");

            body := VerticalLayout {
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: @tr("Edit shortcut"); font-size: 20px; font-weight: 600; color: Theme.text; accessible-role: none; }
                    Text {
                        text: @tr("Press a combination of keys to change the shortcut for {0}.", App.editor.action);
                        font-size: 14px;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    capture := FocusScope {
                        height: 72px;
                        init => { self.focus(); }
                        key-pressed(e) => {
                            if e.text == Key.Escape { App.editor-cancel(); return accept; }
                            if e.text == Key.Tab || e.text == Key.Backtab { return reject; }
                            if e.text == Key.Return && !e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && !e.modifiers.shift {
                                if App.editor.can-save { App.editor-save(); }
                                return accept;
                            }
                            App.editor-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, true);
                            accept
                        }
                        key-released(e) => {
                            App.editor-key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta, false);
                            accept
                        }
                        Rectangle {
                            border-radius: Theme.radius;
                            border-width: capture.has-focus ? 2px : 1px;
                            border-color: capture.has-focus ? Theme.accent : Theme.card-stroke;
                            background: Theme.card-bg;
                            accessible-role: text;
                            accessible-label: App.editor.keys.length == 0 ? @tr("Press keys") : @tr("Shortcut keys");
                            TouchArea { clicked => { capture.focus(); } }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                opacity: App.editor.live ? 0.75 : 1;
                                for k in App.editor.keys: VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 40px;
                                        min-width: 40px;
                                        border-radius: Theme.radius;
                                        background: Theme.accent;
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            Text {
                                                text: k;
                                                font-size: 16px;
                                                font-weight: 600;
                                                color: Theme.on-accent;
                                                vertical-alignment: center;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }
                                }
                                if App.editor.keys.length == 0: Text {
                                    text: @tr("Press keys");
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    if App.editor.error-title != "": InfoBar {
                        data: {
                            visible: true,
                            severity: App.editor.severity,
                            title: App.editor.error-title,
                            message: App.editor.error-message,
                            action: "",
                        };
                    }
                    Text { text: App.editor.hint; font-size: 12px; color: Theme.text-secondary; wrap: word-wrap; }
                }
                // Reset and Clear on the left, Save and Cancel on the right; in a narrow window Save and Cancel go
                // on a second line.
                Rectangle {
                    property <length> pad: Theme.narrow ? 16px : 24px;
                    property <length> line: reset-button.preferred-height;
                    background: Theme.card-bg-secondary;
                    border-bottom-left-radius: Theme.radius;
                    border-bottom-right-radius: Theme.radius;
                    height: Theme.narrow ? 2 * self.pad + 2 * self.line + 8px : 2 * self.pad + self.line;
                    // Reset may ask to confirm; never while a confirm is open.
                    reset-button := Button {
                        x: parent.pad;
                        y: parent.pad;
                        width: self.preferred-width;
                        height: parent.line;
                        text: @tr("Reset to default");
                        enabled: !App.dialog.visible;
                        clicked => { App.editor-reset(); }
                    }
                    clear-button := Button {
                        x: reset-button.x + reset-button.width + 8px;
                        y: parent.pad;
                        width: self.preferred-width;
                        height: parent.line;
                        text: @tr("Clear");
                        enabled: App.editor.can-clear;
                        clicked => { App.editor-clear(); }
                    }
                    cancel-button := Button {
                        x: parent.width - parent.pad - self.width;
                        y: Theme.narrow ? parent.pad + parent.line + 8px : parent.pad;
                        width: self.preferred-width;
                        height: parent.line;
                        text: @tr("Cancel");
                        clicked => { App.editor-cancel(); }
                    }
                    save-button := Button {
                        x: cancel-button.x - 8px - self.width;
                        y: cancel-button.y;
                        width: self.preferred-width;
                        height: parent.line;
                        text: @tr("Save");
                        primary: true;
                        enabled: App.editor.can-save;
                        clicked => { App.editor-save(); }
                    }
                }
            }
        }
    }
}

// "Find hidden settings": read-only snapshot / compare, then name what changed. A sub-page of the Monitor tab.
export component FinderPage inherits VerticalLayout {
    HorizontalLayout {
        spacing: 8px;
        padding-bottom: 8px;
        IconButton {
            glyph: Glyphs.back;
            label: @tr("Back to Monitor");
            clicked => { App.finder-open = false; }
        }
        Text {
            text: @tr("Find hidden settings");
            font-size: 18px;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Text {
        text: @tr("This only reads from the monitor; nothing is written here. It compares the manufacturer's undocumented codes before and after you change one setting with the monitor's own buttons, so you can name what each code controls. A named code then appears in Monitor settings.");
        font-size: 13px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    if App.finder-status.visible: VerticalLayout {
        padding-top: 12px;
        spacing: 4px;
        InfoBar { data: App.finder-status; }
        if App.finder-busy: ProgressIndicator { indeterminate: true; }
    }

    SectionHeader { text: @tr("Steps"); }
    VerticalLayout {
        spacing: 4px;
        Card {
            title: @tr("1. Take a snapshot");
            description: App.finder-snapshot-text;
            Button {
                text: @tr("Take snapshot");
                enabled: App.connected && !App.finder-busy;
                clicked => { App.finder-snapshot(); }
            }
        }
        Card {
            title: @tr("2. Change one setting with the monitor's buttons");
            description: @tr("Pick any one in the monitor's own menu. Change only one, then compare.");
        }
        Card {
            title: @tr("3. Compare");
            description: @tr("Lists the codes whose value changed");
            Button {
                text: @tr("Compare");
                enabled: App.finder-can-compare && App.connected && !App.finder-busy;
                clicked => { App.finder-compare(); }
            }
        }
    }

    if App.finder-changes.length > 0: SectionHeader { text: @tr("Changed"); }
    if App.finder-changes.length > 0: CardFrame {
        VerticalLayout {
            padding: 4px;
            accessible-role: list;
            for c[i] in App.finder-changes: Rectangle {
                height: 36px;
                border-radius: 4px;
                background: i == App.finder-selected ? Theme.subtle-hover : cta.has-hover ? Theme.subtle-pressed : transparent;
                accessible-role: list-item;
                accessible-label: c.text;
                accessible-item-selected: i == App.finder-selected;
                accessible-action-default => { App.finder-select(i); }
                cta := TouchArea { clicked => { App.finder-select(i); } }
                cfs := FocusScope {
                    x: 0;
                    width: 0;   // takes no clicks
                    key-pressed(e) => {
                        if e.text == Key.Space || e.text == Key.Return { App.finder-select(i); return accept; }
                        reject
                    }
                }
                Rectangle {
                    x: 0px;
                    width: 3px;
                    height: i == App.finder-selected ? 16px : 0px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
                Text {
                    x: 12px;
                    text: c.text;
                    font-size: 14px;
                    color: Theme.text;
                    vertical-alignment: center;
                    accessible-role: none;
                }
                if cfs.has-focus: FocusRing { border-radius: 4px; }
            }
        }
    }

    if App.finder-selected >= 0: SectionHeader { text: @tr("Name it"); }
    if App.finder-selected >= 0: CardFrame {
        // Typing breaks the field's binding; put the new change's name back when the form is refilled.
        property <int> form: App.finder-form;
        changed form => { name-edit.text = App.finder-name; }
        VerticalLayout {
            padding: 16px;
            spacing: 8px;
            Text { text: @tr("Setting name"); font-size: 13px; color: Theme.text; }
            name-edit := LineEdit {
                text: App.finder-name;
                placeholder-text: @tr("e.g. Local dimming");
                edited(t) => { App.finder-name-edited(t); }
            }
            for v[i] in App.finder-values: VerticalLayout {
                spacing: 4px;
                padding-top: 4px;
                Text { text: v.caption; font-size: 12px; color: Theme.text-secondary; }
                LineEdit {
                    text: v.label;
                    placeholder-text: @tr("Label (optional)");
                    edited(t) => { App.finder-value-edited(i, t); }
                }
            }
            HorizontalLayout {
                alignment: end;
                padding-top: 4px;
                Button {
                    text: @tr("Save");
                    primary: true;
                    clicked => { App.finder-save(); }
                }
            }
        }
    }
}

// Switches between the Day and Night presets on a schedule. Off / at set times / at sunrise and sunset.
component AutoDayNightCard inherits CardFrame {
    property <int> choice: App.auto-mode;
    VerticalLayout {
        Card {
            border-width: 0px;
            background: transparent;
            glyph: Glyphs.moon;
            title: @tr("Switch presets automatically");
            description: App.auto-note;
            SyncCombo {
                model: [@tr("Off"), @tr("At set times"), @tr("At sunrise and sunset")];
                index: App.auto-mode;
                selected => {
                    root.choice = self.current-index;
                    App.set-auto-mode(self.current-index);
                }
            }
        }
        if root.choice == 1: VerticalLayout {
            RowDivider { }
            HorizontalLayout {
                padding: 12px;
                padding-left: Theme.narrow ? 16px : 52px;
                spacing: 8px;
                Text { text: @tr("Day"); vertical-alignment: center; color: Theme.text; }
                day := LineEdit { text: App.auto-day; width: Theme.narrow ? 64px : 80px; accessible-label: @tr("Day preset time"); }
                Text { text: @tr("Night"); vertical-alignment: center; color: Theme.text; }
                night := LineEdit { text: App.auto-night; width: Theme.narrow ? 64px : 80px; accessible-label: @tr("Night preset time"); }
                Rectangle { horizontal-stretch: 1; }
                Button { text: @tr("Save"); clicked => { App.save-auto-times(day.text, night.text); } }
            }
        }
        if root.choice == 2: VerticalLayout {
            RowDivider { }
            HorizontalLayout {
                padding: 12px;
                padding-left: Theme.narrow ? 16px : 52px;
                spacing: 8px;
                lat := LineEdit { text: App.auto-lat; placeholder-text: @tr("Latitude, e.g. 31.52"); accessible-label: @tr("Latitude"); }
                lon := LineEdit { text: App.auto-lon; placeholder-text: @tr("Longitude, e.g. 74.36"); accessible-label: @tr("Longitude"); }
                Button { text: @tr("Save"); clicked => { App.save-auto-location(lat.text, lon.text); } }
            }
        }
    }
}

export component SettingsPage inherits VerticalLayout {
    if App.setup-hints.length > 0: SectionHeader { text: @tr("System setup"); first: true; }
    if App.setup-hints.length > 0: VerticalLayout {
        spacing: 4px;
        // The message and command, Copy, then the fix button; while it runs (and after) a progress bar and the
        // result line under them.
        for h in App.setup-hints: CardFrame {
            VerticalLayout {
                Card {
                    border-width: 0px;
                    glyph: Glyphs.setup;
                    title: h.title;
                    description: h.command != "" ? h.message + "\n" + h.command : h.message;
                    if h.command != "": Button {
                        text: @tr("Copy");
                        accessible-label: @tr("Copy the command");
                        clicked => { App.copy-text(h.command); }
                    }
                    if h.action != "": Button {
                        text: h.action;
                        primary: true;
                        enabled: !h.busy;
                        clicked => { App.run-setup-fix(h.id); }
                    }
                }
                if h.busy || h.result != "": VerticalLayout {
                    padding-left: 52px;
                    padding-right: 16px;
                    padding-bottom: 12px;
                    spacing: 6px;
                    if h.busy: ProgressIndicator { indeterminate: true; }
                    Text {
                        text: h.result;
                        font-size: 12px;
                        color: h.result-error ? Theme.error-fg : Theme.text-secondary;
                        wrap: word-wrap;
                        accessible-role: text;
                        accessible-label: h.result;
                        accessible-live-region: h.result-error ? AccessibleLiveness.assertive : AccessibleLiveness.polite;
                    }
                }
            }
        }
    }

    // The language names are each in their own language, so only "System" is translated (Rust fills `languages`).
    SectionHeader { text: @tr("Language"); first: App.setup-hints.length == 0; }
    Card {
        glyph: Glyphs.language;
        title: @tr("App language");
        description: @tr("System follows your computer's language");
        SyncCombo {
            model: App.languages;
            index: App.language-index;
            accessible-label: @tr("App language");
            selected => { App.set-language(self.current-index); }
        }
    }

    SectionHeader { text: @tr("Startup"); }
    CardFrame {
        VerticalLayout {
            Card {
                border-width: 0px;
                glyph: Glyphs.background;
                title: @tr("Run in background");
                description: App.background-description;
                LabelledSwitch {
                    checked: App.background-mode;
                    toggled(on) => { App.set-background(on); }
                }
            }
            RowDivider { }
            Card {
                border-width: 0px;
                background: transparent;
                glyph: "";
                title: App.start-label;
                description: App.start-description;
                LabelledSwitch {
                    checked: App.start-with-os;
                    toggled(on) => { App.set-start(on); }
                }
            }
        }
    }

    // Not for a display without inputs (the built-in panel).
    if App.input-labels.length > 0: SectionHeader { text: @tr("This PC"); }
    if App.input-labels.length > 0: Card {
        glyph: Glyphs.display;
        title: @tr("This PC's input");
        description: @tr("We ask before you switch the monitor away from it");
        SyncCombo {
            model: App.input-labels;
            index: App.this-pc-index;
            selected => { App.set-this-pc(self.current-index); }
        }
    }

    if App.presets.length > 0: SectionHeader { text: @tr("Presets"); }
    if App.presets.length > 0: VerticalLayout {
        spacing: 4px;
        for p[i] in App.presets: Card {
            glyph: p.glyph;
            title: p.name;
            description: p.summary;
            reason: App.disabled-reason;
            enabled: App.connected;
            Button {
                text: @tr("Save current");
                enabled: App.connected && !App.values-stale;
                clicked => { App.save-preset(i); }
            }
        }
    }

    SectionHeader { text: @tr("Automatic Day/Night"); }
    AutoDayNightCard { }

    SectionHeader { text: @tr("Keyboard shortcuts"); }
    if App.shortcuts-description != "": Text {
        text: App.shortcuts-description;
        font-size: 12px;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
    if App.shortcuts-description != "": Rectangle { height: 8px; }
    CardFrame {
        VerticalLayout {
            padding-top: 2px;
            padding-bottom: 2px;
            for h[i] in App.hotkeys: VerticalLayout {
                if i > 0: RowDivider { }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    height: 48px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text { text: h.label; font-size: 14px; color: Theme.text; overflow: elide; }
                        if h.warning != "": Text { text: h.warning; font-size: 12px; color: Theme.warning-fg; }
                    }
                    for k in h.keys: VerticalLayout {
                        alignment: center;
                        Keycap { text: k; }
                    }
                    if h.keys.length == 0: Text {
                        text: @tr("Not set");
                        font-size: 12px;
                        color: Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 36px;
                        IconButton {
                            glyph: Glyphs.edit;
                            label: @tr("Edit shortcut: {0}", h.label);
                            clicked => { App.edit-hotkey(i); }
                        }
                    }
                }
            }
        }
    }

    SectionHeader { text: @tr("About"); }
    Card {
        glyph: Glyphs.about;
        title: "ThinkVision Control " + App.version;
        description: App.profile-text;
    }
}

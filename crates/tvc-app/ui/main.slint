// Main window: header with the monitor and its state, a tab strip, one scrolling page.
import { Palette, ScrollView, ProgressIndicator } from "std-widgets.slint";
import "fonts/FluentSystemIcons-Regular.ttf";
import { Theme, Glyphs, Icon } from "theme.slint";
import { App } from "app.slint";
import { Tab, InfoBar, DialogOverlay, Badge, DisplayPicker } from "controls.slint";
import { DisplayPage, TogetherPage, MonitorPage, SettingsPage, FinderPage, ShortcutDialog } from "pages.slint";

export { App }
export { Severity, Banner, InputItem, RangeRow, ControlKind, ControlRow, ControlGroup, PresetRow, HotkeyRow, SetupHint, Dialog, FinderChange, FinderValue, ShortcutEditor } from "types.slint";
export { Tray, Osd } from "background.slint";

export component MainWindow inherits Window {
    // 0 = follow the OS, 1 = dark, 2 = light.
    in property <int> forced-scheme: 0;
    in-out property <int> tab: 0;
    property <bool> compact: root.width < 520px;
    property <bool> narrow: root.width < 440px;
    property <bool> finder-open: App.finder-open;
    property <bool> modal: App.dialog.visible || App.editor.visible;
    // All together: the Display tab shows the master sliders, and the Monitor tab (per display) is hidden.
    property <bool> together: App.selected-id == "" && App.together-available;
    // The Monitor tab has nothing for a display whose only controls are on the Display tab (the built-in panel).
    property <bool> monitor-tab: !root.together && !(App.has-controls && App.monitor-groups.length == 0);

    changed forced-scheme => {
        if root.forced-scheme == 1 { Palette.color-scheme = ColorScheme.dark; }
        else if root.forced-scheme == 2 { Palette.color-scheme = ColorScheme.light; }
    }
    init => { Theme.narrow = root.narrow; }
    changed narrow => { Theme.narrow = root.narrow; }
    changed monitor-tab => { if !root.monitor-tab && root.tab == 1 { root.tab = 0; } }

    title: "ThinkVision Control";
    icon: @image-url("app-icon-32.png");
    preferred-width: 560px;
    preferred-height: 680px;
    min-width: 360px;
    min-height: 520px;
    background: Theme.window-bg;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: 14px;

    // Keys reach only the focused element and its parents, so the window starts focused on `keys`, and focus goes
    // back there whenever the element holding it goes away: the page on a tab switch, a closed dialog.
    forward-focus: keys;
    changed tab => { if !(tab-display.has-focus || tab-monitor.has-focus || tab-settings.has-focus) { keys.focus(); } }
    changed finder-open => { keys.focus(); }
    changed modal => { if !root.modal { keys.focus(); } }

    // Ctrl+1/2/3 switch tabs, wherever the focus is in the window.
    keys := FocusScope {
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if e.modifiers.control && e.text == "1" { root.tab = 0; return accept; }
            if e.modifiers.control && e.text == "2" && root.monitor-tab { root.tab = 1; return accept; }
            if e.modifiers.control && e.text == "3" { root.tab = 2; return accept; }
            reject
        }

        VerticalLayout {
            // Header: monitor glyph, name, connection line.
            HorizontalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-top: Theme.narrow ? 12px : 16px;
                padding-bottom: 8px;
                spacing: Theme.narrow ? 10px : 14px;
                Icon {
                    text: Glyphs.display;
                    font-size: Theme.narrow ? 30px : 38px;
                    width: Theme.narrow ? 28px : 36px;
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        Text {
                            text: App.model-name;
                            font-size: Theme.narrow ? 16px : 18px;
                            font-weight: 600;
                            color: Theme.text;
                            overflow: elide;
                        }
                        // How far the display is supported, after its name. Each badge brings its own gap.
                        if root.together: VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Badge { text: @tr("Together"); }
                        }
                        if !root.together && App.experimental: VerticalLayout {
                            alignment: center;
                            padding-left: 8px;
                            Badge { text: @tr("Experimental"); warning: true; }
                        }
                        for d in App.displays: VerticalLayout {
                            alignment: center;
                            if !root.together && d.id == App.selected-id && d.kind == "built-in": VerticalLayout {
                                padding-left: 8px;
                                Badge { text: @tr("Built-in"); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Icon {
                            text: App.status-glyph;
                            font-size: 13px;
                            width: 13px;
                            color: App.connected ? Theme.success-fg : Theme.text-secondary;
                        }
                        Text {
                            text: App.status-text;
                            font-size: 13px;
                            color: Theme.text-secondary;
                            overflow: elide;
                            accessible-role: text;
                            accessible-live-region: polite;
                        }
                    }
                }
            }

            // Display picker: hidden with only one display.
            if App.displays.length >= 2: VerticalLayout {
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-bottom: Theme.narrow ? 10px : 12px;
                DisplayPicker {
                    displays: App.displays;
                    selected: App.selected-id;
                    selected-name: root.together ? @tr("All together") : App.model-name;
                    together-available: App.together-available;
                    select(id) => { App.select-display(id); }
                }
            }

            // Tabs.
            Rectangle {
                height: 41px;
                HorizontalLayout {
                    padding-left: Theme.gutter - 12px;
                    alignment: start;
                    accessible-role: tab-list;
                    tab-display := Tab { label: @tr("Display"); selected: root.tab == 0; clicked => { root.tab = 0; } }
                    tab-monitor := Tab { label: @tr("Monitor"); shown: root.monitor-tab; selected: root.tab == 1; clicked => { root.tab = 1; } }
                    tab-settings := Tab { label: @tr("Settings"); selected: root.tab == 2; clicked => { root.tab = 2; } }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.divider;
                }
            }

            // Page.
            Rectangle {
                vertical-stretch: 1;
                background: Theme.layer-bg;
                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding-left: max(Theme.gutter, (root.width - 720px) / 2);
                        padding-right: max(Theme.gutter, (root.width - 720px) / 2);
                        padding-top: 16px;
                        padding-bottom: 24px;
                        spacing: 0px;

                        if App.banner.visible: VerticalLayout {
                            padding-bottom: 12px;
                            spacing: 4px;
                            InfoBar {
                                data: App.banner;
                                action => { App.banner-action(); }
                            }
                            if App.loading: ProgressIndicator { indeterminate: true; }
                        }
                        if root.tab == 0 && !root.together: DisplayPage { compact: root.compact; }
                        if root.tab == 0 && root.together: TogetherPage { compact: root.compact; }
                        if root.tab == 1 && root.monitor-tab && !App.finder-open: MonitorPage { }
                        if root.tab == 1 && root.monitor-tab && App.finder-open: FinderPage { }
                        if root.tab == 2: SettingsPage { }
                    }
                }
            }
        }
    }

    // Toast: short result messages ("Brightness stays 0: the colour mode locks it"). Always there, hidden while
    // empty, so a screen reader announces each new message.
    Rectangle {
        visible: App.toast != "";
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 16px;
        width: min(parent.width - 32px, toast-text.preferred-width + 32px);
        height: toast-text.preferred-height + 20px;
        border-radius: Theme.radius;
        background: Theme.dark ? #3a3a3a : #2b2b2b;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000044;
        accessible-role: text;
        accessible-label: App.toast;
        accessible-live-region: polite;
        toast-text := Text {
            width: parent.width - 32px;
            text: App.toast;
            font-size: 13px;
            color: #ffffff;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }

    if App.editor.visible: ShortcutDialog { }

    if App.dialog.visible: DialogOverlay {
        data: App.dialog;
        result(ok) => { App.dialog-result(ok); }
    }
}

msgctxt "FinderPage"
msgid "2. Change one setting with the monitor's buttons"
msgstr "2. 用显示器按钮更改一项设置"

#: crates/tvc-app/ui/pages.slint:667
msgctxt "FinderPage"
msgid "Pick any one in the monitor's own menu. Change only one, then compare."

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>probe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- GtkSharp registers GLib types/properties by reflection; trimming these assemblies
       crashes at startup (NullReferenceException in GLib.GType.op_Explicit). Keep them whole. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Eto" />
    <TrimmerRootAssembly Include="Eto.Gtk" />
    <TrimmerRootAssembly Include="GLibSharp" />
    <TrimmerRootAssembly Include="GioSharp" />
    <TrimmerRootAssembly Include="GtkSharp" />
    <TrimmerRootAssembly Include="GdkSharp" />
    <TrimmerRootAssembly Include="AtkSharp" />
    <TrimmerRootAssembly Include="PangoSharp" />
    <TrimmerRootAssembly Include="CairoSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Eto.Forms" Version="*" />
    <PackageReference Include="Eto.Platform.Gtk" Version="*" />
  </ItemGroup>
</Project>

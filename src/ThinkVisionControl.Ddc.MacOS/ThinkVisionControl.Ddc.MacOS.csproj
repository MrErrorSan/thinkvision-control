<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Plain P/Invoke into system frameworks, so it builds anywhere; callers must check OperatingSystem.IsMacOS(). -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- probe/ is a separate file-based app (dotnet run probe/MacDdcProbe.cs), not part of this library. -->
    <Compile Remove="probe/**" />
    <InternalsVisibleTo Include="ThinkVisionControl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThinkVisionControl.Core\ThinkVisionControl.Core.csproj" />
  </ItemGroup>

</Project>

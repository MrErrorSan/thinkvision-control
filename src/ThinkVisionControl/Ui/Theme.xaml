<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Colours come from the built-in WPF Fluent theme (App.xaml sets ThemeMode="System"); always reference them
        with DynamicResource so they follow light/dark and the accent colour live.

        Fluent keys verified in PresentationFramework.Fluent 10.0.12 (Fluent.Light.xaml and Fluent.Dark.xaml both
        define every key below; checked by loading the dictionaries and dumping their keys):
          Text:      TextFillColorPrimaryBrush, TextFillColorSecondaryBrush, TextFillColorTertiaryBrush,
                     TextFillColorDisabledBrush, TextOnAccentFillColorPrimaryBrush
          Surfaces:  CardBackgroundFillColorDefaultBrush, CardBackgroundFillColorSecondaryBrush,
                     CardStrokeColorDefaultBrush, LayerFillColorDefaultBrush, SmokeFillColorDefaultBrush,
                     SolidBackgroundFillColorBaseBrush, SolidBackgroundFillColorQuarternaryBrush,
                     DividerStrokeColorDefaultBrush, SurfaceStrokeColorDefaultBrush
          Controls:  ControlFillColorDefaultBrush, ControlFillColorSecondaryBrush, ControlFillColorTertiaryBrush,
                     SubtleFillColorSecondaryBrush, SubtleFillColorTertiaryBrush, SubtleFillColorTransparentBrush,
                     ControlStrongStrokeColorDefaultBrush, ControlStrokeColorDefaultBrush
          Accent:    AccentFillColorDefaultBrush, AccentFillColorDisabledBrush
          Status:    SystemFillColorCriticalBrush, SystemFillColorCautionBrush, SystemFillColorAttentionBrush,
                     SystemFillColorSuccessBrush, SystemFillColorSolidNeutralBrush
          Controls the theme lacks but whose brushes it ships: ToggleSwitch* (Fill/Stroke/KnobFill On/Off,
                     PointerOver/Pressed/Disabled, ContentForeground), InfoBarBorderBrush,
                     InfoBar{Informational|Success|Warning|Error}SeverityBackgroundBrush / …SeverityIconBackground,
                     ContentDialogBackground, ContentDialogTopOverlay, ContentDialogBorderBrush,
                     ContentDialogSeparatorBorderBrush, ContentDialogSmokeFill
          Styles:    AccentButtonStyle (Button), DefaultControlFocusVisualStyle, implicit {x:Type Window} / {x:Type Button}
        No app-defined fallback brushes are needed: every key above exists in both theme dictionaries.
    -->

    <!-- Type ramp (Windows 11): Segoe UI Variable, Text optical size below 20 px and Display from 20 px. -->
    <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BodyLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Group header above a stack of SettingsCards (Toolkit SettingsSectionHeaderTextBlockStyle). -->
    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
        <Setter Property="Margin" Value="1,30,0,6" />
    </Style>

</ResourceDictionary>

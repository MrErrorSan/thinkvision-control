<UserControl x:Class="ThinkVisionControl.Ui.Pages.MonitorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ThinkVisionControl.Ui.Controls"
             Focusable="False">
    <UserControl.Resources>
        <ResourceDictionary Source="PageResources.xaml" />
    </UserControl.Resources>
    <!-- DataContext: PanelViewModel. Mockup A, page "Monitor settings". The setting sections come from
         PanelViewModel.MonitorGroups, so codes named in the finder appear here without changes. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid Margin="36,0,36,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Monitor settings" Style="{StaticResource PageTitleStyle}" />

                <c:InfoBar Margin="0,16,0,0" IsClosable="False" IsOpen="{Binding IsInfoBarOpen}" Severity="{Binding InfoBarSeverity}"
                           Title="{Binding InfoBarTitle}" Message="{Binding InfoBarMessage}" ActionContent="{Binding InfoBarAction}"
                           ActionCommand="{Binding InfoBarCommand}" ShowProgress="{Binding InfoBarProgress}" />

                <StackPanel IsEnabled="{Binding IsConnected}">
                    <ItemsControl ItemsSource="{Binding MonitorGroups}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Style="{StaticResource SectionHeaderStyle}" />
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding HasPower, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Power" Style="{StaticResource SectionHeaderStyle}" />
                        <c:SettingsCard Header="Power" Icon="&#xE7E8;" Description="{Binding PowerItem.Description}">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Standby" MinWidth="96" Command="{Binding StandbyCommand}"
                                        Visibility="{Binding CanStandby, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Turn off" MinWidth="96" Margin="8,0,0,0" Command="{Binding TurnOffCommand}"
                                        Visibility="{Binding CanTurnOff, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </c:SettingsCard>
                    </StackPanel>

                    <TextBlock Text="Reset" Style="{StaticResource SectionHeaderStyle}" />
                    <c:SettingsExpander Header="Reset and restore" Icon="&#xE7A7;"
                                        Description="Return settings to their factory values, or restore a backup">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ResetItems}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <c:SettingsCard Header="{Binding Name}" Description="{Binding Description}">
                                            <Button Content="Reset" MinWidth="96" Command="{Binding Run}"
                                                    AutomationProperties.Name="{Binding Name}" />
                                        </c:SettingsCard>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:SettingsCard Header="Restore backup" Description="{Binding RestoreBackupDescription}">
                                <Button Content="Restore" MinWidth="96" Command="{Binding RestoreBackupCommand}"
                                        AutomationProperties.Name="Restore backup" />
                            </c:SettingsCard>
                        </StackPanel>
                    </c:SettingsExpander>

                    <TextBlock Text="Tools" Style="{StaticResource SectionHeaderStyle}" />
                    <c:SettingsCard Header="Find hidden settings" Icon="&#xE721;" IsClickEnabled="True" Click="FindHidden_Click"
                                    Description="Look for settings your monitor supports but doesn't list" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:ThinkVisionControl.Ui"
                    xmlns:p="clr-namespace:ThinkVisionControl.Ui.Pages"
                    xmlns:c="clr-namespace:ThinkVisionControl.Ui.Controls">

    <!-- Shared by the settings pages (merged into PanelWindow). Colours are Fluent keys only. -->

    <!-- 4 px between top-level cards. Cards inside a SettingsExpander keep the expander's own row style. -->
    <Style TargetType="c:SettingsCard" BasedOn="{StaticResource {x:Type c:SettingsCard}}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style TargetType="c:SettingsExpander" BasedOn="{StaticResource {x:Type c:SettingsExpander}}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextStyle}">
        <Setter Property="Margin" Value="0,20,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource SettingsSectionHeaderStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A slider bound to a RangeItem. Maximum is set before Value so a late Max never clamps (and writes back) a value. -->
    <Style x:Key="LiveSliderStyle" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="p:LiveSlider.IsLive" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
    </Style>

    <!-- Square transparent button holding one glyph (More, Edit). -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="ContentTemplate" Value="{StaticResource GlyphContentTemplate}" />
    </Style>

    <!-- Button content "glyph + text": the button's Tag is the glyph, its Content the text. Being a template, the text
         follows the button's disabled colour (the Fluent theme's implicit TextBlock style would pin it otherwise). -->
    <DataTemplate x:Key="GlyphTextTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="{StaticResource IconFont}"
                       FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- Small bordered key label, e.g. Ctrl. -->
    <Style x:Key="KeycapStyle" TargetType="Border">
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
    </Style>

    <!-- Monitor setting cards, chosen by item type (ToggleItem before its base EnumItem). -->
    <DataTemplate DataType="{x:Type ui:RangeItem}">
        <c:SettingsCard Header="{Binding Name}" Description="{Binding Description}" Icon="{Binding Icon}">
            <StackPanel Orientation="Horizontal">
                <Slider Width="200" Style="{StaticResource LiveSliderStyle}"
                        Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" />
                <TextBlock Text="{Binding ValueText}" MinWidth="32" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center" />
            </StackPanel>
        </c:SettingsCard>
    </DataTemplate>

    <DataTemplate DataType="{x:Type ui:EnumItem}">
        <c:SettingsCard Header="{Binding Name}" Description="{Binding Description}" Icon="{Binding Icon}">
            <ComboBox MinWidth="140" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding Name}" />
        </c:SettingsCard>
    </DataTemplate>

    <DataTemplate DataType="{x:Type ui:ToggleItem}">
        <c:SettingsCard Header="{Binding Name}" Description="{Binding Description}" Icon="{Binding Icon}">
            <c:ToggleSwitch IsChecked="{Binding IsOn, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
        </c:SettingsCard>
    </DataTemplate>

</ResourceDictionary>

<Window x:Class="ThinkVisionControl.Ui.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ThinkVisionControl.Ui"
        Title="ThinkVision Control"
        Width="360" SizeToContent="Height" WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True"
        Background="Transparent">
    <!-- The window itself paints nothing: DWM draws the acrylic backdrop, the rounded corners and the 1 px border.
         WindowChrome hides the caption that ApplyChrome adds back (DWM only draws a system backdrop on a window
         with a caption or a sizing frame). FallbackChrome is filled in only when the backdrop can't be applied. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border x:Name="FallbackChrome" BorderThickness="0">
        <ui:QuickControlsView x:Name="QuickControls" Margin="16" />
    </Border>
</Window>

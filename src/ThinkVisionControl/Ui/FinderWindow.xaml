<Window x:Class="ThinkVisionControl.Ui.FinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ThinkVisionControl.Ui.Controls"
        Title="Find hidden settings"
        Icon="/ThinkVisionControl;component/Assets/ThinkVisionControl.ico"
        Width="600" Height="720" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <!-- Background stays unset so the Fluent theme's Mica shows through. -->
    <Window.Resources>
        <Style TargetType="c:SettingsCard" BasedOn="{StaticResource {x:Type c:SettingsCard}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource SettingsSectionHeaderStyle}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="24,16,24,24">
            <TextBlock Text="Find hidden settings" Style="{StaticResource SubtitleTextStyle}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="This only reads from the monitor; nothing is written here. It compares Lenovo's undocumented codes before and after you change one setting with the monitor's own buttons, so you can name what each code controls. A named code then appears in Monitor settings." />

            <c:InfoBar x:Name="StatusBar" Margin="0,16,0,0" IsClosable="False" />

            <TextBlock Text="Step 1" Style="{StaticResource SectionHeader}" />
            <c:SettingsCard x:Name="SnapshotCard" Header="Take a snapshot" Icon="&#xE722;"
                            Description="Reads the current value of every code the monitor reports">
                <Button x:Name="SnapshotButton" Content="Take snapshot" MinWidth="120" Click="Snapshot_Click" />
            </c:SettingsCard>

            <TextBlock Text="Step 2" Style="{StaticResource SectionHeader}" />
            <c:SettingsCard Header="Change one setting with the monitor's buttons" Icon="&#xE7F4;"
                            Description="For example Over Drive. Change only one, then compare." />

            <TextBlock Text="Step 3" Style="{StaticResource SectionHeader}" />
            <c:SettingsCard Header="Compare" Icon="&#xE8FD;" Description="Lists the codes whose value changed">
                <Button x:Name="CompareButton" Content="Compare" MinWidth="120" IsEnabled="False" Click="Compare_Click" />
            </c:SettingsCard>
            <ListBox x:Name="ChangesList" MinHeight="60" MaxHeight="180" SelectionChanged="ChangesList_SelectionChanged"
                     AutomationProperties.Name="Changed codes" />

            <StackPanel x:Name="NamingPanel" Visibility="Collapsed">
                <TextBlock Text="Name this setting" Style="{StaticResource SectionHeader}" />
                <c:SettingsCard Header="Setting name" Icon="&#xE8AC;">
                    <TextBox x:Name="NameBox" Width="240" AutomationProperties.Name="Setting name" />
                </c:SettingsCard>
                <TextBlock Margin="1,8,0,8" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Name the values you know (cycle through them with the monitor's buttons and compare again if needed). Unnamed values keep their hex code." />
                <ItemsControl x:Name="ValuesList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:SettingsCard Header="{Binding Caption}" MinHeight="52" Padding="16,8">
                                <TextBox Width="240" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{Binding Caption}" />
                            </c:SettingsCard>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="0,12,0,0" HorizontalAlignment="Right" MinWidth="120" Content="Save" Style="{DynamicResource AccentButtonStyle}"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>

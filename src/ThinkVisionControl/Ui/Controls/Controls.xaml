<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:c="clr-namespace:ThinkVisionControl.Ui.Controls">

    <!-- Default styles for the hand-built Windows 11 controls. Merged into App.xaml after Ui/Theme.xaml, whose text
         styles and fonts these reference; colours are Fluent theme keys (see the list at the top of Theme.xaml).
         Values follow the WinUI / Community Toolkit templates and mockup variant A. -->

    <!-- Transparent button with a subtle hover fill (WinUI SubtleButtonStyle); Fluent WPF does not ship one. -->
    <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ SettingsCard -->
    <Style TargetType="c:SettingsCard">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsCard">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconGlyph" Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Width="20" Margin="2,0,20,0" VerticalAlignment="Center" TextAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter x:Name="HeaderPresenter" Content="{TemplateBinding Header}"
                                                  TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <ContentPresenter x:Name="DescriptionPresenter" Content="{TemplateBinding Description}"
                                                  TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                  TextBlock.LineHeight="16" TextBlock.LineStackingStrategy="BlockLineHeight">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <ContentPresenter x:Name="ContentPart" Grid.Column="2" Margin="16,0,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            <TextBlock x:Name="ActionGlyph" Grid.Column="3" Text="{TemplateBinding ActionIcon}" Visibility="Collapsed"
                                       FontFamily="{StaticResource IconFont}" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentPart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClickEnabled" Value="True">
                            <Setter TargetName="ActionGlyph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsClickEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="DescriptionPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ SettingsExpander -->
    <Style TargetType="c:SettingsExpander">
        <Style.Resources>
            <!-- Child cards: rows inside the expander body, aligned with the header text, separated by 1 px lines. -->
            <Style TargetType="c:SettingsCard" BasedOn="{StaticResource {x:Type c:SettingsCard}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="58,8,44,8" />
                <Setter Property="MinHeight" Value="52" />
            </Style>
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsExpander">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" MinHeight="68" CornerRadius="4" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <ToggleButton x:Name="ExpandToggle" Focusable="True" Cursor="Arrow"
                                              FocusVisualStyle="{DynamicResource DefaultControlFocusVisualStyle}"
                                              AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Grid Margin="16,16,8,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="IconGlyph" Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20"
                                               Width="20" Margin="2,0,20,0" VerticalAlignment="Center" TextAlignment="Center" IsHitTestVisible="False" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                          TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight">
                                            <ContentPresenter.Resources>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                        <ContentPresenter x:Name="DescriptionPresenter" Content="{TemplateBinding Description}"
                                                          TextElement.FontSize="12" TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                          TextBlock.LineHeight="16" TextBlock.LineStackingStrategy="BlockLineHeight">
                                            <ContentPresenter.Resources>
                                                <DataTemplate DataType="{x:Type sys:String}">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ContentPresenter.Resources>
                                        </ContentPresenter>
                                    </StackPanel>
                                    <ContentPresenter x:Name="HeaderContentPart" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                                      Content="{TemplateBinding HeaderContent}" />
                                    <Border Grid.Column="3" Width="32" Height="32" Margin="8,0,0,0" IsHitTestVisible="False">
                                        <TextBlock x:Name="Chevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border x:Name="Body" Grid.Row="1" Visibility="Collapsed" BorderThickness="1,0,1,1" CornerRadius="0,0,4,4"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <!-- The clip hides the first child card's top separator; the header's bottom edge already draws it. -->
                            <Grid ClipToBounds="True">
                                <ContentPresenter Margin="0,-1,0,0" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="DescriptionPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HeaderContent" Value="{x:Null}">
                            <Setter TargetName="HeaderContentPart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="ExpandToggle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger SourceName="ExpandToggle" Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="4,4,0,0" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="DescriptionPresenter" Property="TextElement.Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ ToggleSwitch -->
    <Style TargetType="c:ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForeground}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ToggleSwitch">
                    <Grid Background="{TemplateBinding Background}" MinHeight="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="24" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Label" Content="{TemplateBinding OffContent}" Margin="0,0,12,0"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Grid Grid.Column="1" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    Background="{DynamicResource ToggleSwitchFillOff}" BorderBrush="{DynamicResource ToggleSwitchStrokeOff}" />
                            <Grid x:Name="PART_Knob" Width="20" Height="20" HorizontalAlignment="Left">
                                <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="OffContent" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Label" Property="Content" Value="{Binding OnContent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffPointerOver}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPointerOver}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnPointerOver}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnPointerOver}" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Knob" Property="Width" Value="17" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource ToggleSwitchContentForegroundDisabled}" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEnabled" Value="False" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ InfoBar -->
    <Style TargetType="c:InfoBar">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InfoBarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,0,8,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:InfoBar">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="16" Height="16" Margin="0,16,14,16" VerticalAlignment="Top">
                                <TextBlock x:Name="IconBackground" Text="&#xF136;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource InfoBarInformationalSeverityIconBackground}" />
                                <TextBlock x:Name="IconGlyph" Text="&#xF13F;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="0,14,8,14" VerticalAlignment="Top">
                                <WrapPanel>
                                    <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="0,0,12,0"
                                               TextWrapping="Wrap" LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                    <TextBlock x:Name="MessageText" Text="{TemplateBinding Message}" TextWrapping="Wrap"
                                               LineHeight="20" LineStackingStrategy="BlockLineHeight" />
                                </WrapPanel>
                                <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,10,0,2" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="ActionButton" Grid.Column="2" Margin="8,8,8,8" VerticalAlignment="Top"
                                    Content="{TemplateBinding ActionContent}" Command="{TemplateBinding ActionCommand}" />
                            <Button x:Name="PART_CloseButton" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32"
                                    Margin="0,8,0,8" VerticalAlignment="Top" AutomationProperties.Name="Close"
                                    Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource InfoBarSuccessSeverityIconBackground}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13E;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource InfoBarWarningSeverityIconBackground}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13C;" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="IconBackground" Property="Foreground" Value="{DynamicResource InfoBarErrorSeverityIconBackground}" />
                            <Setter TargetName="IconGlyph" Property="Text" Value="&#xF13D;" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="">
                            <Setter TargetName="ActionButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowProgress" Value="True">
                            <Setter TargetName="Progress" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Severity" Value="Success">
                <Setter Property="Background" Value="{DynamicResource InfoBarSuccessSeverityBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource InfoBarWarningSeverityBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Severity" Value="Error">
                <Setter Property="Background" Value="{DynamicResource InfoBarErrorSeverityBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ ContentDialogHost -->
    <Style TargetType="c:ContentDialogHost">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ContentDialogHost">
                    <Grid>
                        <ContentPresenter />
                        <Grid x:Name="PART_Overlay" Visibility="Collapsed" Background="{DynamicResource ContentDialogSmokeFill}"
                              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Contained">
                            <Grid x:Name="PART_Dialog" MinWidth="320" MaxWidth="548" Margin="24" HorizontalAlignment="Center"
                                  VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" AutomationProperties.IsDialog="True">
                                <!-- Shadow on a sibling so the dialog text keeps ClearType. -->
                                <Border CornerRadius="8" Background="{DynamicResource ContentDialogBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.3" Color="Black" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ContentDialogBorderBrush}"
                                        Background="{DynamicResource ContentDialogBackground}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{DynamicResource ContentDialogTopOverlay}" CornerRadius="7,7,0,0" Padding="24"
                                                TextElement.Foreground="{DynamicResource ContentDialogForeground}">
                                            <StackPanel>
                                                <TextBlock x:Name="PART_Title" Style="{StaticResource SubtitleTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                                <ContentPresenter x:Name="PART_Body" TextElement.FontFamily="{StaticResource TextFont}" TextElement.FontSize="14"
                                                                  TextBlock.LineHeight="20" TextBlock.LineStackingStrategy="BlockLineHeight">
                                                    <ContentPresenter.Resources>
                                                        <DataTemplate DataType="{x:Type sys:String}">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                        </DataTemplate>
                                                    </ContentPresenter.Resources>
                                                </ContentPresenter>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Row="1" Padding="24" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ContentDialogSeparatorBorderBrush}">
                                            <UniformGrid Rows="1" Margin="-4,0">
                                                <Button x:Name="PART_PrimaryButton" Margin="4,0" HorizontalAlignment="Stretch"
                                                        IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}" />
                                                <Button x:Name="PART_SecondaryButton" Margin="4,0" HorizontalAlignment="Stretch" />
                                                <Button x:Name="PART_CloseButton" Margin="4,0" HorizontalAlignment="Stretch" />
                                            </UniformGrid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ NavigationPane / NavigationItem -->
    <Style x:Key="NavigationPaneToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Content" Value="&#xE700;" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="AutomationProperties.Name" Value="Navigation" />
    </Style>

    <Style TargetType="c:NavigationItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TextFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="4,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NavigationItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" Margin="12,0">
                                <TextBlock Text="{TemplateBinding Icon}" FontFamily="{StaticResource IconFont}" FontSize="16" Width="16"
                                           VerticalAlignment="Center" TextAlignment="Center" />
                                <TextBlock x:Name="LabelText" Text="{TemplateBinding Label}" Margin="16,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                        </MultiTrigger>
                        <DataTrigger Binding="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=c:NavigationPane}}" Value="True">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed" />
                            <Setter Property="ToolTip" Value="{Binding Label, RelativeSource={RelativeSource Self}}" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:NavigationPane">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,4" />
        <Setter Property="Width" Value="{Binding OpenPaneLength, RelativeSource={RelativeSource Self}}" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Local" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:NavigationPane">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <Button x:Name="PART_PaneToggle" DockPanel.Dock="Top" Style="{StaticResource NavigationPaneToggleButtonStyle}"
                                    AutomationProperties.Name="Navigation" ToolTip="Navigation" />
                            <StackPanel DockPanel.Dock="Bottom">
                                <Border x:Name="FooterDivider" Height="1" Margin="0,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                <ListBox x:Name="PART_FooterList" ItemsSource="{TemplateBinding FooterItems}" Background="Transparent"
                                         BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <StackPanel IsItemsHost="True" />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                </ListBox>
                            </StackPanel>
                            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding FooterItems.Count, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="FooterDivider" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsCompact" Value="True">
                <Setter Property="Width" Value="48" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

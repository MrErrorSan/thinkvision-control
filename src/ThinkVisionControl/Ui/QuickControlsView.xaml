<UserControl x:Class="ThinkVisionControl.Ui.QuickControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:ThinkVisionControl.Ui.Controls"
             Width="360" Focusable="False">
    <!-- Tray flyout content (mockup A10). DataContext: the shared PanelViewModel. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Pages/PageResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,12,0,8" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Plain text that greys out with its disabled container. -->
            <Style x:Key="ItemTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Brightness / contrast row: glyph, slider, value. DataContext: RangeItem. -->
            <DataTemplate x:Key="SliderRow">
                <Grid Height="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="20" Style="{StaticResource ItemTextStyle}" />
                    <Slider Grid.Column="1" Style="{StaticResource LiveSliderStyle}" Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2" Text="{Binding ValueText}" MinWidth="32" Margin="8,0,0,0" TextAlignment="Right"
                               Style="{StaticResource ItemTextStyle}" />
                </Grid>
            </DataTemplate>

            <!-- Input tile: a radio button drawn as a 48 px tile; the selected one takes the accent fill. -->
            <Style x:Key="InputTileStyle" TargetType="RadioButton">
                <Setter Property="Height" Value="48" />
                <Setter Property="Margin" Value="4,0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Tile" CornerRadius="4" BorderThickness="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsEnabled" Value="False" />
                                        <Condition Property="IsChecked" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentFillColorDisabledBrush}" />
                                    <Setter TargetName="Tile" Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorDisabledBrush}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="20,16,20,20">
            <TextBlock Text="{Binding MonitorTitle}" Style="{StaticResource BodyStrongTextStyle}" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <!-- Compact InfoBar: at this width the action sits under the text rather than beside it. -->
            <Grid Margin="0,8,0,4">
                <c:InfoBar IsClosable="False" IsOpen="{Binding IsInfoBarOpen}" Severity="{Binding InfoBarSeverity}"
                           Title="{Binding InfoBarTitle}" Message="{Binding InfoBarMessage}" ShowProgress="{Binding InfoBarProgress}">
                    <c:InfoBar.Style>
                        <Style TargetType="c:InfoBar" BasedOn="{StaticResource {x:Type c:InfoBar}}">
                            <Setter Property="Padding" Value="16,0,8,44" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InfoBarAction}" Value="{x:Null}">
                                    <Setter Property="Padding" Value="16,0,8,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </c:InfoBar.Style>
                </c:InfoBar>
                <Button Content="{Binding InfoBarAction}" Command="{Binding InfoBarCommand}" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" Margin="46,0,0,14">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InfoBarAction}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsInfoBarOpen}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <StackPanel IsEnabled="{Binding IsConnected}">
                <ContentControl Content="{Binding BrightnessItem}" ContentTemplate="{StaticResource SliderRow}" Focusable="False" />
                <ContentControl Content="{Binding ContrastItem}" ContentTemplate="{StaticResource SliderRow}" Focusable="False" />

                <StackPanel Visibility="{Binding HasInput, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Input" Style="{StaticResource LabelStyle}" />
                    <ItemsControl ItemsSource="{Binding InputItem.Options}" Focusable="False" Margin="-4,0" AutomationProperties.Name="Input">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource InputTileStyle}" GroupName="QuickInput" Click="InputTile_Click"
                                             IsChecked="{Binding IsActive, Mode=OneWay}" AutomationProperties.Name="{Binding Label}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                                        <TextBlock Text="This PC" FontSize="12" HorizontalAlignment="Center"
                                                   Visibility="{Binding IsThisPc, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Inline confirmation when switching away from this PC's input (no dialog in the flyout). -->
                    <Border x:Name="ConfirmPanel" Visibility="Collapsed" Margin="0,8,0,0" Padding="12" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            AutomationProperties.Name="{Binding Text, ElementName=ConfirmTitle}">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmTitle" Style="{StaticResource BodyStrongTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ConfirmMessage" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,4,0,12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <UniformGrid Rows="1" Margin="-4,0">
                                <Button x:Name="ConfirmButton" Margin="4,0" HorizontalAlignment="Stretch" Click="Confirm_Click" />
                                <Button x:Name="CancelButton" Content="Cancel" Margin="4,0" HorizontalAlignment="Stretch"
                                        Style="{DynamicResource AccentButtonStyle}" Click="CancelConfirm_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Visibility="{Binding HasColourMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Colour mode" Style="{StaticResource LabelStyle}" />
                    <ComboBox ItemsSource="{Binding ColourModeItem.Options}" SelectedItem="{Binding ColourModeItem.Selected, Mode=TwoWay}"
                              HorizontalAlignment="Stretch" AutomationProperties.Name="Colour mode" />
                </StackPanel>

                <TextBlock Text="Presets" Style="{StaticResource LabelStyle}" />
                <UniformGrid Rows="1" Margin="-4,0">
                    <Button Margin="4,0" HorizontalAlignment="Stretch" Command="{Binding Day.ApplyCommand}" AutomationProperties.Name="Day preset"
                            Content="Day" Tag="&#xE706;" ContentTemplate="{StaticResource GlyphTextTemplate}" />
                    <Button Margin="4,0" HorizontalAlignment="Stretch" Command="{Binding Night.ApplyCommand}" AutomationProperties.Name="Night preset"
                            Content="Night" Tag="&#xE708;" ContentTemplate="{StaticResource GlyphTextTemplate}" />
                </UniformGrid>
            </StackPanel>
        </StackPanel>

        <!-- Footer: status as icon + text, and the way into the full window. -->
        <Border Grid.Row="1" Height="48" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <DockPanel Margin="20,0,8,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Padding="12,6" Click="AllSettings_Click"
                        Content="All settings" Tag="&#xE713;" ContentTemplate="{StaticResource GlyphTextTemplate}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusGlyph}" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusShortText}" Style="{StaticResource CaptionTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

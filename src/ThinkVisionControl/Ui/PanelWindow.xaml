<Window x:Class="ThinkVisionControl.Ui.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ThinkVisionControl.Ui.Controls"
        Title="ThinkVision Control"
        Icon="/ThinkVisionControl;component/Assets/ThinkVisionControl.ico"
        Width="1008" Height="720" MinWidth="500" MinHeight="500"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <!-- Mockup variant A: navigation pane on the left, one page of settings cards on the right. Background stays unset so
         the Fluent theme's Mica shows through. -->
    <c:ContentDialogHost x:Name="DialogHost">
        <Grid>
            <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False" />

            <!-- Shown behind the pane while it is opened over the content in a narrow window. -->
            <Border x:Name="PaneOverlay" HorizontalAlignment="Left" Visibility="Collapsed" BorderThickness="0,0,1,0"
                    Width="{Binding OpenPaneLength, ElementName=Nav}"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" />

            <c:NavigationPane x:Name="Nav" HorizontalAlignment="Left" OpenPaneLength="320"
                              PaneToggleRequested="Nav_PaneToggleRequested"
                              SelectedNavigationItem="{Binding CurrentPage, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=Window}}">
                <c:NavigationItem x:Name="DisplayItem" Icon="&#xE7F4;" Label="Display" />
                <c:NavigationItem x:Name="MonitorItem" Icon="&#xE9E9;" Label="Monitor settings" />
                <c:NavigationPane.FooterItems>
                    <c:NavigationItem x:Name="AppItem" Icon="&#xE713;" Label="App settings" />
                </c:NavigationPane.FooterItems>
            </c:NavigationPane>
        </Grid>
    </c:ContentDialogHost>
</Window>

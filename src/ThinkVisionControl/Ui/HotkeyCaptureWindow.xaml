<Window x:Class="ThinkVisionControl.Ui.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set shortcut"
        Style="{StaticResource ChromelessWindow}"
        Width="340" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20">
        <TextBlock x:Name="ActionText" Style="{StaticResource HeaderText}" />
        <TextBlock Text="Press the shortcut you want to use." Margin="0,10,0,4" />
        <TextBlock Text="Include Ctrl, Alt, Shift, or Win. Press Esc to cancel."
                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
        <TextBlock x:Name="HintText" Style="{StaticResource WarnText}" Margin="0,8,0,0" />
        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0" />
    </StackPanel>
</Window>

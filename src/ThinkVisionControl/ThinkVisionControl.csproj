<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationIcon>Assets\ThinkVisionControl.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!-- Publish: a small folder for the installer (packaging/windows). It uses the shared .NET 10 Desktop Runtime,
       which the installer adds when missing; without it the .NET host shows a "please install" message.
       R2R precompiles the app's own code so start-up doesn't wait on the JIT. -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ThinkVisionControl.ico" />
    <Resource Include="Assets\Tray.OnDark.ico" />
    <Resource Include="Assets\Tray.OnLight.ico" />
    <!-- WinForms is only used for NotifyIcon; keep its namespaces out of implicit usings to avoid WPF type clashes. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThinkVisionControl.Core\ThinkVisionControl.Core.csproj" />
    <ProjectReference Include="..\ThinkVisionControl.Ddc.Windows\ThinkVisionControl.Ddc.Windows.csproj" />
  </ItemGroup>

</Project>

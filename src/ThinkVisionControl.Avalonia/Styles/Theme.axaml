<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Bundled Fluent UI System Icons (MIT, see Assets/Fonts/LICENSE). Codepoints: Styles/IconGlyphs.cs. -->
    <FontFamily x:Key="IconFont">avares://thinkvision-control/Assets/Fonts#FluentSystemIcons-Regular</FontFamily>
    <!-- Brand accent; App.ApplyAccent uses it when the OS gives no accent. -->
    <Color x:Key="EmberColor">#F05A28</Color>
  </Styles.Resources>

  <!-- Windows 11 type ramp (size / line height). Use as <TextBlock Classes="Subtitle" />. -->
  <Style Selector="TextBlock.Caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="16" />
  </Style>
  <Style Selector="TextBlock.Body">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBlock.BodyStrong">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="20" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.BodyLarge">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LineHeight" Value="24" />
  </Style>
  <Style Selector="TextBlock.Subtitle">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LineHeight" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.Title">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="LineHeight" Value="36" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- A TextBlock that shows an IconGlyphs codepoint. -->
  <Style Selector="TextBlock.Icon">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

</Styles>

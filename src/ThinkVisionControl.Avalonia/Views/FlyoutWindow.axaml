<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:ThinkVisionControl.Avalonia.ViewModels"
        xmlns:v="using:ThinkVisionControl.Avalonia.Views"
        x:Class="ThinkVisionControl.Avalonia.Views.FlyoutWindow"
        x:DataType="vm:MainViewModel"
        Title="ThinkVision Control"
        Width="360" SizeToContent="Height" CanResize="False" CanMinimize="False" CanMaximize="False"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="0">
  <!-- Quick Settings-style tray flyout (mockup A10). DataContext: the shared MainViewModel. -->
  <Window.Styles>
    <StyleInclude Source="/Views/ViewStyles.axaml" />
    <Style Selector="TextBlock.Label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="StackPanel.Quick TextBlock:disabled">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
    </Style>
    <!-- Input tile: the selected one takes the accent fill (ToggleButton's checked look). -->
    <Style Selector="ToggleButton.Tile">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Height" Value="48" />
    </Style>
    <Style Selector="Button.Stretch">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Brightness / contrast row: glyph, slider, value. -->
    <DataTemplate x:Key="SliderRow" x:DataType="vm:RangeItem">
      <Grid ColumnDefinitions="28,*,40" Height="44">
        <TextBlock Classes="Icon" Text="{Binding Icon}" FontSize="18" />
        <Slider Grid.Column="1" Classes="Live" Margin="8,0" v:LiveSlider.IsLive="True" AutomationProperties.Name="{Binding Name}"
                Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" />
        <TextBlock Grid.Column="2" Classes="SliderValue" Text="{Binding ValueText}" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Panel>
    <ExperimentalAcrylicBorder x:Name="AcrylicLayer" IsVisible="False" IsHitTestVisible="False">
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="#2C2C2C" TintOpacity="0.8" MaterialOpacity="0.7" FallbackColor="#2C2C2C" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>

    <StackPanel x:Name="Root">
      <StackPanel Classes="Quick" Margin="20,18,20,16">
        <TextBlock Classes="BodyStrong" Text="{Binding MonitorTitle}" />
        <v:StateBar Margin="0,12,0,0" />

        <StackPanel IsEnabled="{Binding IsConnected}" Margin="0,8,0,0">
          <ContentControl Content="{Binding BrightnessItem}" ContentTemplate="{StaticResource SliderRow}" Focusable="False" />
          <ContentControl Content="{Binding ContrastItem}" ContentTemplate="{StaticResource SliderRow}" Focusable="False" />

          <StackPanel IsVisible="{Binding HasInput}">
            <TextBlock Classes="Label" Text="Input" />
            <ItemsControl ItemsSource="{Binding InputItem.Options, FallbackValue={x:Null}}" AutomationProperties.Name="Input">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" ColumnSpacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnumOption">
                  <ToggleButton Classes="Tile" IsChecked="{Binding IsActive, Mode=OneWay}" Click="InputTile_Click"
                                AutomationProperties.Name="{Binding Label}">
                    <StackPanel HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                      <TextBlock Text="This PC" FontSize="11" HorizontalAlignment="Center" IsVisible="{Binding IsThisPc}" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Inline confirmation when switching away from this PC's input (no dialog in the flyout). -->
            <Border x:Name="ConfirmPanel" IsVisible="False" Margin="0,8,0,0" Padding="12" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <StackPanel>
                <TextBlock x:Name="ConfirmTitle" Classes="BodyStrong" TextWrapping="Wrap" />
                <TextBlock x:Name="ConfirmMessage" Classes="Caption Secondary" TextWrapping="Wrap" Margin="0,4,0,12" />
                <UniformGrid Rows="1" ColumnSpacing="8">
                  <Button x:Name="ConfirmButton" Classes="Stretch" Click="Confirm_Click" />
                  <Button x:Name="CancelButton" Classes="Stretch accent" Content="Cancel" Click="CancelConfirm_Click" />
                </UniformGrid>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding HasColourMode}">
            <TextBlock Classes="Label" Text="Colour mode" />
            <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding ColourModeItem.Options, FallbackValue={x:Null}}"
                      SelectedItem="{Binding ColourModeItem.Selected, Mode=TwoWay, FallbackValue={x:Null}}" AutomationProperties.Name="Colour mode">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:EnumOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <TextBlock Classes="Label" Text="Presets" />
          <UniformGrid Rows="1" ColumnSpacing="8">
            <Button Classes="Stretch" Command="{Binding Day.ApplyCommand}" AutomationProperties.Name="Day preset">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="Icon" Text="{x:Static vm:Glyphs.Day}" />
                <TextBlock Text="Day" />
              </StackPanel>
            </Button>
            <Button Classes="Stretch" Command="{Binding Night.ApplyCommand}" AutomationProperties.Name="Night preset">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="Icon" Text="{x:Static vm:Glyphs.Night}" />
                <TextBlock Text="Night" />
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
      </StackPanel>

      <!-- Footer: status as icon + text, and the way into the full window. -->
      <Border Background="{DynamicResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0" Padding="20,8,8,8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="Icon Secondary" Text="{Binding StatusGlyph}" FontSize="14" />
            <TextBlock Classes="Caption Secondary" Text="{Binding StatusShortText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Theme="{DynamicResource TransparentButton}" Padding="12,6" Click="AllSettings_Click">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="Icon" Text="{x:Static vm:Glyphs.Settings}" />
              <TextBlock Text="All settings" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
    </StackPanel>
  </Panel>
</Window>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:ThinkVisionControl.Avalonia.ViewModels"
             xmlns:v="using:ThinkVisionControl.Avalonia.Views"
             x:Class="ThinkVisionControl.Avalonia.Views.Pages.MonitorPage"
             x:DataType="vm:MainViewModel">
  <!-- Mockup A, page "Monitor settings". The sections come from MainViewModel.MonitorGroups, so codes named in the
       finder appear here without changes. Card templates: MainWindow.DataTemplates. -->
  <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Classes="Page">
      <TextBlock Classes="PageTitle" Text="Monitor settings" />

      <v:StateBar Margin="0,16,0,0" />

      <StackPanel IsEnabled="{Binding IsConnected}">
        <ItemsControl ItemsSource="{Binding MonitorGroups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsGroup">
              <StackPanel>
                <TextBlock Classes="SectionHeader" Text="{Binding Header}" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Classes="Cards" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding HasPower}">
          <TextBlock Classes="SectionHeader" Text="Power" />
          <ui:FASettingsExpander Header="Power" Description="{Binding PowerItem.Description, FallbackValue={x:Null}}"
                                 IconSource="{v:Glyph {x:Static vm:Glyphs.Power}}">
            <ui:FASettingsExpander.Footer>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Standby" MinWidth="96" Command="{Binding StandbyCommand}" IsVisible="{Binding CanStandby}" />
                <Button Content="Turn off" MinWidth="96" Command="{Binding TurnOffCommand}" IsVisible="{Binding CanTurnOff}" />
              </StackPanel>
            </ui:FASettingsExpander.Footer>
          </ui:FASettingsExpander>
        </StackPanel>

        <TextBlock Classes="SectionHeader" Text="Reset" />
        <ui:FASettingsExpander Header="Reset and restore" Description="Return settings to their factory values, or restore a backup"
                               IconSource="{v:Glyph {x:Static vm:Glyphs.Reset}}"
                               ItemsSource="{Binding ResetRows}">
          <ui:FASettingsExpander.Styles>
            <Style Selector="ui|FASettingsExpander > ui|FASettingsExpanderItem" x:DataType="vm:IActionRow">
              <Setter Property="Description" Value="{Binding Description}" />
              <Setter Property="Footer" Value="{Binding}" />
              <Setter Property="FooterTemplate">
                <DataTemplate x:DataType="vm:IActionRow">
                  <Button Content="{Binding ButtonText}" MinWidth="96" Command="{Binding Run}" AutomationProperties.Name="{Binding Name}" />
                </DataTemplate>
              </Setter>
            </Style>
          </ui:FASettingsExpander.Styles>
          <ui:FASettingsExpander.ItemTemplate>
            <DataTemplate x:DataType="vm:IActionRow">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ui:FASettingsExpander.ItemTemplate>
        </ui:FASettingsExpander>

        <TextBlock Classes="SectionHeader" Text="Tools" />
        <ui:FASettingsExpander Header="Find hidden settings" Description="Look for settings your monitor supports but doesn't list"
                               IsClickEnabled="True" Click="FindHidden_Click"
                               IconSource="{v:Glyph {x:Static vm:Glyphs.Search}}"
                               ActionIconSource="{v:Glyph {x:Static vm:Glyphs.ChevronRight}}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- "ThinkVisionControl" is the WPF app's assembly name; this one must differ. Also the Linux/macOS binary name. -->
    <AssemblyName>thinkvision-control</AssemblyName>
    <RootNamespace>ThinkVisionControl.Avalonia</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\brand\ico\ThinkVisionControl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[12.1.3]" />
    <PackageReference Include="Avalonia.Desktop" Version="[12.1.3]" />
    <PackageReference Include="FluentAvaloniaUI" Version="[3.1.0]" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\FluentSystemIcons-Regular.ttf" />
    <!-- One icon everywhere (assets/brand); linked, not copied. Used as the window icon at runtime. -->
    <AvaloniaResource Include="..\..\assets\brand\ico\ThinkVisionControl.ico" Link="Assets\ThinkVisionControl.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThinkVisionControl.Core\ThinkVisionControl.Core.csproj" />
    <ProjectReference Include="..\ThinkVisionControl.Ddc.Windows\ThinkVisionControl.Ddc.Windows.csproj" />
    <ProjectReference Include="..\ThinkVisionControl.Ddc.Linux\ThinkVisionControl.Ddc.Linux.csproj" />
    <ProjectReference Include="..\ThinkVisionControl.Ddc.MacOS\ThinkVisionControl.Ddc.MacOS.csproj" />
  </ItemGroup>

</Project>

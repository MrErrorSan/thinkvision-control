<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:vm="using:ThinkVisionControl.Avalonia.ViewModels"
        xmlns:v="using:ThinkVisionControl.Avalonia.Views"
        x:Class="ThinkVisionControl.Avalonia.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ThinkVision Control"
        Icon="/Assets/ThinkVisionControl.ico"
        Width="1008" Height="720" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <!-- Mockup variant A: navigation pane on the left, one page of settings cards on the right. -->
  <Window.Styles>
    <StyleInclude Source="/Views/ViewStyles.axaml" />
  </Window.Styles>

  <!-- Monitor setting cards, chosen by item type (ToggleItem before its base EnumItem). Used by the Display and
       Monitor settings pages through ContentControl / ItemsControl. -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:RangeItem">
      <ui:FASettingsExpander Header="{Binding Name}" Description="{Binding Description}"
                             IconSource="{Binding Icon, Converter={x:Static v:Converters.Glyph}}">
        <ui:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <!-- Maximum before Value, so a late Max never clamps (and writes back) a value. -->
            <Slider Classes="Live" Width="200" v:LiveSlider.IsLive="True" AutomationProperties.Name="{Binding Name}"
                    Maximum="{Binding Max}" Value="{Binding Value, Mode=TwoWay}" />
            <TextBlock Classes="SliderValue" Text="{Binding ValueText}" />
          </StackPanel>
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>
    </DataTemplate>

    <DataTemplate DataType="vm:ToggleItem">
      <ui:FASettingsExpander Header="{Binding Name}" Description="{Binding Description}"
                             IconSource="{Binding Icon, Converter={x:Static v:Converters.Glyph}}">
        <ui:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
            <ToggleSwitch Classes="Bare" IsChecked="{Binding IsOn, Mode=TwoWay}" AutomationProperties.Name="{Binding Name}" />
          </StackPanel>
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>
    </DataTemplate>

    <DataTemplate DataType="vm:EnumItem">
      <ui:FASettingsExpander Header="{Binding Name}" Description="{Binding Description}"
                             IconSource="{Binding Icon, Converter={x:Static v:Converters.Glyph}}">
        <ui:FASettingsExpander.Footer>
          <ComboBox MinWidth="155" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                    AutomationProperties.Name="{Binding Name}">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="vm:EnumOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>
    </DataTemplate>

    <DataTemplate DataType="vm:PresetItem">
      <ui:FASettingsExpander Header="{Binding Name}" Description="{Binding Description}"
                             IconSource="{Binding Icon, Converter={x:Static v:Converters.Glyph}}">
        <ui:FASettingsExpander.Footer>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Apply" MinWidth="80" Command="{Binding ApplyCommand}" />
            <Button Classes="Icon" ToolTip.Tip="More options" AutomationProperties.Name="{Binding MoreName}">
              <TextBlock Classes="Icon" Text="{x:Static vm:Glyphs.More}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{Binding SaveText}" Click="SavePreset_Click" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </StackPanel>
        </ui:FASettingsExpander.Footer>
      </ui:FASettingsExpander>
    </DataTemplate>
  </Window.DataTemplates>

  <ui:FANavigationView x:Name="Nav"
                       PaneDisplayMode="Auto" IsSettingsVisible="False" IsBackButtonVisible="False"
                       OpenPaneLength="320" AlwaysShowHeader="False"
                       CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="1008">
    <ui:FANavigationView.MenuItems>
      <ui:FANavigationViewItem x:Name="NavDisplay" Content="Display">
        <ui:FANavigationViewItem.IconSource>
          <ui:FAFontIconSource Glyph="{x:Static vm:Glyphs.Display}" FontFamily="{StaticResource IconFont}" />
        </ui:FANavigationViewItem.IconSource>
      </ui:FANavigationViewItem>
      <ui:FANavigationViewItem x:Name="NavMonitor" Content="Monitor settings">
        <ui:FANavigationViewItem.IconSource>
          <ui:FAFontIconSource Glyph="{x:Static vm:Glyphs.Options}" FontFamily="{StaticResource IconFont}" />
        </ui:FANavigationViewItem.IconSource>
      </ui:FANavigationViewItem>
    </ui:FANavigationView.MenuItems>
    <ui:FANavigationView.FooterMenuItems>
      <ui:FANavigationViewItem x:Name="NavApp" Content="App settings">
        <ui:FANavigationViewItem.IconSource>
          <ui:FAFontIconSource Glyph="{x:Static vm:Glyphs.Settings}" FontFamily="{StaticResource IconFont}" />
        </ui:FANavigationViewItem.IconSource>
      </ui:FANavigationViewItem>
    </ui:FANavigationView.FooterMenuItems>

    <ContentControl x:Name="PageHost" Focusable="False" />
  </ui:FANavigationView>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:st="using:ThinkVisionControl.Avalonia.Styles"
        x:Class="ThinkVisionControl.Avalonia.MainWindow"
        Title="ThinkVision Control"
        Icon="/Assets/ThinkVisionControl.ico"
        Width="1008" Height="720" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <!-- Placeholder shell; the real pages come with the avalonia-ui task. -->
  <ui:FANavigationView x:Name="Nav"
                       PaneDisplayMode="Left" IsSettingsVisible="False" IsBackButtonVisible="False"
                       OpenPaneLength="320" IsPaneOpen="True"
                       CompactModeThresholdWidth="0" ExpandedModeThresholdWidth="0">
    <ui:FANavigationView.MenuItems>
      <ui:FANavigationViewItem x:Name="NavDisplay" Content="Display" Tag="Display">
        <ui:FANavigationViewItem.IconSource>
          <ui:FAFontIconSource Glyph="{x:Static st:IconGlyphs.Display}" FontFamily="{StaticResource IconFont}" />
        </ui:FANavigationViewItem.IconSource>
      </ui:FANavigationViewItem>
      <ui:FANavigationViewItem Content="Monitor settings" Tag="Monitor settings">
        <ui:FANavigationViewItem.IconSource>
          <ui:FAFontIconSource Glyph="{x:Static st:IconGlyphs.Brightness}" FontFamily="{StaticResource IconFont}" />
        </ui:FANavigationViewItem.IconSource>
      </ui:FANavigationViewItem>
    </ui:FANavigationView.MenuItems>
    <ui:FANavigationView.FooterMenuItems>
      <ui:FANavigationViewItem Content="App settings" Tag="App settings">
        <ui:FANavigationViewItem.IconSource>
          <ui:FAFontIconSource Glyph="{x:Static st:IconGlyphs.Settings}" FontFamily="{StaticResource IconFont}" />
        </ui:FANavigationViewItem.IconSource>
      </ui:FANavigationViewItem>
    </ui:FANavigationView.FooterMenuItems>

    <StackPanel Margin="36,26,36,36" Spacing="12">
      <TextBlock x:Name="PageTitle" Classes="Title" Text="Display" />
      <TextBlock Classes="Body" Text="ThinkVision Control (Avalonia scaffold)" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Classes="Icon" FontSize="32" Text="{x:Static st:IconGlyphs.Sunny}" />
        <TextBlock Classes="Icon" FontSize="32" Text="{x:Static st:IconGlyphs.Contrast}" />
        <TextBlock Classes="Icon" FontSize="32" Text="{x:Static st:IconGlyphs.Input}"
                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
      </StackPanel>
      <Button Classes="accent" Content="Accent button" />
    </StackPanel>
  </ui:FANavigationView>
</Window>

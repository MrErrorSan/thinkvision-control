; ThinkVision Control installer (Inno Setup 6.5+). Build with scripts/make-windows-setup.ps1, which builds the app
; with cargo (target\release\thinkvision-control.exe and tvc.exe) and passes the version from Cargo.toml.
;
; The app is one self-contained exe: no runtime to install. tvc.exe is its console launcher for scripts and terminals.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#define AppName "ThinkVision Control"
#define AppExe "thinkvision-control.exe"

[Setup]
AppId={{C040F988-B1EE-407E-AAC8-81D5912B5E47}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=ThinkVision Control contributors
AppPublisherURL=https://github.com/MrErrorSan/thinkvision-control
AppSupportURL=https://github.com/MrErrorSan/thinkvision-control/issues
VersionInfoVersion={#AppVersion}
DefaultDirName={autopf}\{#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
; "setup.exe /CURRENTUSER" installs for this user only, without admin (scripted installs and testing).
PrivilegesRequiredOverridesAllowed=commandline
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.17763
WizardStyle=modern dynamic
SetupIconFile=..\..\assets\brand\ico\ThinkVisionControl.ico
UninstallDisplayIcon={app}\{#AppExe}
UninstallDisplayName={#AppName}
; Restart Manager closes a running copy, also in a silent install (winget): 0.0.8 and later exit cleanly when asked,
; older ones are ended. No AppMutex: in a silent install its prompt defaults to Cancel and setup gives up.
; [Run] starts the app again if it was running; the uninstaller closes it in [Code].
CloseApplications=force
RestartApplications=no
OutputDir=..\..\build
OutputBaseFilename=ThinkVisionControl-Setup-{#AppVersion}
Compression=lzma2/max
SolidCompression=yes

[Tasks]
Name: startmenuicon; Description: "Create a Start menu shortcut"; GroupDescription: "Shortcuts:"
Name: desktopicon; Description: "Create a desktop shortcut"; GroupDescription: "Shortcuts:"

[Files]
Source: "..\..\target\release\{#AppExe}"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\target\release\tvc.exe"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\LICENSE"; DestDir: "{app}"; DestName: "LICENSE.txt"; Flags: ignoreversion
Source: "..\..\LICENSE-GPL-3.0.txt"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\..\crates\tvc-app\ui\fonts\LICENSE-FluentSystemIcons.txt"; DestDir: "{app}"; Flags: ignoreversion
; Generated by cargo-about (scripts/make-windows-setup.ps1); a local build without cargo-about leaves it out.
Source: "..\..\build\THIRD-PARTY-NOTICES.txt"; DestDir: "{app}"; Flags: ignoreversion skipifsourcedoesntexist

[InstallDelete]
; Leftovers of the portable 0.0.1 and 0.0.2 exe, which Windows never listed under Apps: the Start menu shortcut it made
; itself (pointing wherever the exe was run from) and the files it unpacked into Temp on first run. Here only for a
; /CURRENTUSER install: an elevated setup's {userprograms} is the admin's, so [Run] removes them as the original user.
Type: files; Name: "{userprograms}\{#AppName}.lnk"; Check: not IsAdminInstallMode
Type: filesandordirs; Name: "{%TEMP}\.net\ThinkVisionControl"; Check: not IsAdminInstallMode
; The .NET build that 0.0.3 and 0.0.4 installed here.
Type: files; Name: "{app}\ThinkVisionControl.exe"
Type: files; Name: "{app}\ThinkVisionControl.dll"
Type: files; Name: "{app}\ThinkVisionControl.Core.dll"
Type: files; Name: "{app}\ThinkVisionControl.Ddc.Windows.dll"
Type: files; Name: "{app}\ThinkVisionControl.deps.json"
Type: files; Name: "{app}\ThinkVisionControl.runtimeconfig.json"

[Icons]
Name: "{autoprograms}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: startmenuicon
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExe}"; Tasks: desktopicon

[Registry]
; thinkvision:// links (thinkvision://preset/night, ...). HKA is HKLM for an all-users install, HKCU with /CURRENTUSER.
Root: HKA; Subkey: "Software\Classes\thinkvision"; ValueType: string; ValueName: ""; ValueData: "URL:{#AppName}"; Flags: uninsdeletekey
Root: HKA; Subkey: "Software\Classes\thinkvision"; ValueType: string; ValueName: "URL Protocol"; ValueData: ""
Root: HKA; Subkey: "Software\Classes\thinkvision\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"",0"
Root: HKA; Subkey: "Software\Classes\thinkvision\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\{#AppExe}"" ""%1"""

[Run]
Filename: "{cmd}"; Parameters: "/c del /q ""%APPDATA%\Microsoft\Windows\Start Menu\Programs\{#AppName}.lnk"" & rd /s /q ""%TEMP%\.net\ThinkVisionControl"""; Flags: runhidden runasoriginaluser; Check: IsAdminInstallMode
; runasoriginaluser: setup runs elevated, the app must not. Running before the upgrade: back in the tray, also silently.
Filename: "{app}\{#AppExe}"; Description: "Launch {#AppName}"; Flags: nowait postinstall skipifsilent runasoriginaluser; Check: not AppWasRunning
Filename: "{app}\{#AppExe}"; Parameters: "--startup"; Flags: nowait runasoriginaluser; Check: AppWasRunning

[Code]
const
  // The app's single-instance mutex, prefix + user SID (platform/instance.rs), and its hidden event window
  // (platform/monitor_events.rs).
  AppMutexPrefix = 'ThinkVisionControl.Instance.';
  EventsWindowClass = 'ThinkVisionControl.MonitorEvents';
  RunKey = 'Software\Microsoft\Windows\CurrentVersion\Run';
  WM_ENDSESSION = $0016;
  ENDSESSION_CLOSEAPP = 1;

var
  WasRunning: Boolean;
  AppMutexName: String;

// The SID of the account setup runs as, from `whoami /user /fo csv /nh`: "domain\user","S-1-5-21-...".
function UserSid(): String;
var
  Output: TExecOutput;
  ResultCode, I: Integer;
  Line: String;
begin
  Result := '';
  if ExecAndCaptureOutput(ExpandConstant('{sys}\whoami.exe'), '/user /fo csv /nh', '', SW_HIDE,
       ewWaitUntilTerminated, ResultCode, Output) and (ResultCode = 0) and (GetArrayLength(Output.StdOut) > 0) then
  begin
    Line := Trim(Output.StdOut[0]);
    I := Pos('","', Line);
    if I > 0 then
      Result := Copy(Line, I + 3, Length(Line) - I - 3);
  end;
end;

// The mutex finds a copy run by the account setup runs as (the usual UAC prompt). When an admin elevates for a
// standard user the SIDs differ; the event window, found in this session whoever runs it, covers that case.
function IsAppRunning(): Boolean;
begin
  Result := CheckForMutexes(AppMutexName) or (FindWindowByClassName(EventsWindowClass) <> 0);
end;

function InitializeSetup(): Boolean;
begin
  AppMutexName := AppMutexPrefix + UserSid();
  WasRunning := IsAppRunning();
  Result := True;
end;

function InitializeUninstall(): Boolean;
begin
  AppMutexName := AppMutexPrefix + UserSid();
  Result := True;
end;

function AppWasRunning(): Boolean;
begin
  Result := WasRunning;
end;

// Asks a running copy to exit the way Windows does at sign-out, and waits up to 5 s for it.
procedure CloseRunningApp();
var
  Wnd: HWND;
  I: Integer;
begin
  if not IsAppRunning() then
    Exit;
  Wnd := FindWindowByClassName(EventsWindowClass);
  if Wnd <> 0 then
    PostMessage(Wnd, WM_ENDSESSION, 1, ENDSESSION_CLOSEAPP);
  for I := 1 to 50 do
  begin
    if not IsAppRunning() then
      Exit;
    Sleep(100);
  end;
end;

// The app writes two per-user entries: "Start with Windows" (the Run value) and thinkvision:// (HKCU\Software\Classes,
// registered at every start). An elevated uninstaller's HKCU is the admin's, and the original user can't be reached
// from the uninstaller, so this walks HKEY_USERS: every signed-in user, the one uninstalling included. Only entries
// that point at this install's exe are removed.
procedure RemoveUserEntries();
var
  Users: TArrayOfString;
  I: Integer;
  Exe, Entry: String;
begin
  Exe := Lowercase(ExpandConstant('{app}\{#AppExe}'));
  if not RegGetSubkeyNames(HKU, '', Users) then
    Exit;
  for I := 0 to GetArrayLength(Users) - 1 do
  begin
    if RegQueryStringValue(HKU, Users[I] + '\' + RunKey, 'ThinkVisionControl', Entry)
       and (Pos(Exe, Lowercase(Entry)) > 0) then
      RegDeleteValue(HKU, Users[I] + '\' + RunKey, 'ThinkVisionControl');
    if RegQueryStringValue(HKU, Users[I] + '\Software\Classes\thinkvision\shell\open\command', '', Entry)
       and (Pos(Exe, Lowercase(Entry)) > 0) then
      RegDeleteKeyIncludingSubkeys(HKU, Users[I] + '\Software\Classes\thinkvision');
  end;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  // After the user confirmed, before any file is removed.
  if CurUninstallStep = usUninstall then
    CloseRunningApp();
  if CurUninstallStep = usPostUninstall then
    RemoveUserEntries();
end;
